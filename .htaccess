# Al Rabeesh Dental Software - Apache Configuration
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Allow direct access to existing backend API, downloads, and SDK files
    RewriteCond %{REQUEST_URI} ^/backend/ [NC,OR]
    RewriteCond %{REQUEST_URI} ^/downloads/ [NC,OR]
    RewriteCond %{REQUEST_URI} ^/ReaderSDK/ [NC]
    RewriteRule ^ - [L]

    # Map static assets to dental-app/dist/
    RewriteRule ^assets/(.*)$ dental-app/dist/assets/$1 [L]
    RewriteRule ^downloads/(.*)$ dental-app/dist/downloads/$1 [L]
    RewriteRule ^favicon\.svg$ dental-app/dist/favicon.svg [L]
    RewriteRule ^icons\.svg$ dental-app/dist/icons.svg [L]

    # Serve compiled SPA frontend for all other requests
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ dental-app/dist/index.html [L]
</IfModule>

# Set default directory index to compiled frontend
DirectoryIndex index.html dental-app/dist/index.html index.php

# Prevent 403 on directory listing
Options -Indexes +FollowSymLinks

# Allow large requests for clinical attachments & dental X-Rays (up to 128MB)
LimitRequestBody 134217728

<IfModule mod_php.c>
    php_value upload_max_filesize 128M
    php_value post_max_size 128M
    php_value memory_limit 512M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 128M
    php_value post_max_size 128M
    php_value memory_limit 512M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 128M
    php_value post_max_size 128M
    php_value memory_limit 512M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>

# Disable caching for index files so updates reflect immediately
<IfModule mod_headers.c>
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

